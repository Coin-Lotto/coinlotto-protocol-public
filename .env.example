# Used only for external-network deployments. Compilation and unit tests do not read this file.

# Deployer key. Required for mainnet, Base, and BNB Chain. Never commit a real key.
PRIVATE_KEY=

# JSON-RPC endpoints for the networks configured in hardhat.config.ts.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=

# Default admin, token owner, and minter. Defaults to the deployer when unset.
ADMIN_ADDRESS=
MINTER_ADDRESS=

# LayerZero EndpointV2 on the target chain. Required by CoinLotto.
LZ_ENDPOINT=

# Chainlink VRF v2.5 wrapper on the target chain. Required by RndConsumer.
VRF_WRAPPER=
CALLBACK_GAS_LIMIT=500000
REQUEST_CONFIRMATIONS=3

# First lottery id assigned by LotteryHub. Use 1 for a fresh deployment.
INITIAL_LOTTERY_ID=1

# Non-zero placeholder passed to CltMissions. Replaced later with setHub / setLottery.
LOTTERY_PLACEHOLDER=

# Library and contract addresses for standalone scripts. deployAll.ts fills these locally.
LOTTERY_PRIZE_LIB=
LOTTERY_CORE_LIB=
PROTOCOL_MANAGER_LIB=
LOTTERY_HUB=

# Optional linker granted REFERRAL_LINKER_ROLE. Leave empty to skip.
LINKER_ADDRESS=

# Reserve. RESERVE_ADMIN may be empty (address zero) for self-administration.
# PROPOSERS and EXECUTORS are comma-separated addresses.
RESERVE_TOKEN=
RESERVE_PROPOSERS=
RESERVE_EXECUTORS=
RESERVE_ADMIN=
